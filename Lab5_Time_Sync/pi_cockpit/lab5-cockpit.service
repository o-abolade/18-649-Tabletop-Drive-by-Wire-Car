[Unit]
Description=Lab 5 cockpit N1 (Raft + time sync)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/team1/18-649-Tabletop-Drive-by-Wire-Car/Lab5_Time_Sync/pi_cockpit
# Startup mode and other flags, editable without sudo, e.g.
#   COCKPIT_ARGS=--rt --leader=random --seed=24301
EnvironmentFile=-/home/team1/lab5-cockpit.env
ExecStartPre=/bin/bash ./boot_can.sh
ExecStart=/bin/sh -c 'exec ./cockpit ${COCKPIT_ARGS:---rt}'
Restart=always
RestartSec=2
TimeoutStartSec=30
StandardInput=null
StandardOutput=append:/home/team1/lab5-cockpit.log
StandardError=append:/home/team1/lab5-cockpit.log

[Install]
WantedBy=multi-user.target
