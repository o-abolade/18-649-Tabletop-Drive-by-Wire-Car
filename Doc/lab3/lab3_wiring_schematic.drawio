<mxfile host="app.diagrams.net"><diagram name="Lab 3 wiring" id="lab3wiring"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1754" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Lab 3 wiring: dual-redundant CAN (CAN A, CAN B), 500 kbit/s, three nodes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Bus order on both buses: N1 (Pi) at one end, N2 in the middle, N3 at the other end. Every module is an XIAO CAN board (MCP2515 + SN65HVD230, 16 MHz crystal, 3.3 V). Each CANH/CANL tap goes through its own jumper wire = the R4.8 fault-injection point. Bus breadboard probe rows A_H, A_L, B_H, B_L. Common GND between Pi, both Nucleos and the bus breadboard." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1640" height="40" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#1f6fd1;strokeWidth=3;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="90" as="sourcePoint"/><mxPoint x="1700" y="90" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;A_H&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="70" height="20" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#1f6fd1;strokeWidth=2;dashed=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="112" as="sourcePoint"/><mxPoint x="1700" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;A_L&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="70" height="20" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;strokeColor=#e0662b;strokeWidth=3;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="150" as="sourcePoint"/><mxPoint x="1700" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;B_H&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="70" height="20" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;html=1;strokeColor=#e0662b;strokeWidth=2;dashed=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="172" as="sourcePoint"/><mxPoint x="1700" y="172" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;B_L&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="70" height="20" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;CAN A&lt;/b&gt; (one wire colour) · solid = CANH, dashed = CANL" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1420" y="72" width="280" height="16" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;CAN B&lt;/b&gt; (second wire colour)" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1420" y="132" width="280" height="16" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fff2cc;strokeColor=#1f6fd1;arcSize=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="108" y="92" width="24" height="18" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fff2cc;strokeColor=#e0662b;arcSize=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="108" y="152" width="24" height="18" as="geometry"/></mxCell><mxCell id="c17" value="120 Ω per bus:&lt;br&gt;P1 on N1's modules" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="100" height="34" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fff2cc;strokeColor=#1f6fd1;arcSize=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1648" y="92" width="24" height="18" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fff2cc;strokeColor=#e0662b;arcSize=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1648" y="152" width="24" height="18" as="geometry"/></mxCell><mxCell id="c20" value="120 Ω per bus:&lt;br&gt;P1 on N3's modules" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1600" y="198" width="100" height="34" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;CAN A module&lt;/b&gt; · P1 shorted (bus end)&lt;br&gt;&lt;table style='font-size:9px' cellpadding='0'&gt;&lt;tr&gt;&lt;td&gt;3V3&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D8 SCK&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 23 GPIO11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D9 MISO&lt;/td&gt;&lt;td&gt;&amp;rarr;&lt;/td&gt;&lt;td&gt;pin 21 GPIO9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D10 MOSI&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 19 GPIO10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D7 CS&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 24 CE0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D6 INT&lt;/td&gt;&lt;td&gt;&amp;rarr;&lt;/td&gt;&lt;td&gt;pin 22 GPIO25&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;Terminal: CANH, CANL → jumpers ↑" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#1f6fd1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="225" height="165" as="geometry"/></mxCell><mxCell id="c22" value="&lt;div style='text-align:center'&gt;JAH&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#f5f5f5;strokeColor=#1f6fd1;arcSize=4;rounded=0;spacingLeft=0;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="128" y="238" width="44" height="18" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=none;html=1;strokeColor=#1f6fd1;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="256" as="sourcePoint"/><mxPoint x="150" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="" style="endArrow=none;html=1;strokeColor=#1f6fd1;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="90" as="sourcePoint"/><mxPoint x="150" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;div style='text-align:center'&gt;JAL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#f5f5f5;strokeColor=#1f6fd1;arcSize=4;rounded=0;spacingLeft=0;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="198" y="238" width="44" height="18" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=none;html=1;strokeColor=#1f6fd1;strokeWidth=2;dashed=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="256" as="sourcePoint"/><mxPoint x="220" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="endArrow=none;html=1;strokeColor=#1f6fd1;strokeWidth=2;dashed=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="112" as="sourcePoint"/><mxPoint x="220" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;CAN B module&lt;/b&gt; · P1 shorted (bus end)&lt;br&gt;&lt;table style='font-size:9px' cellpadding='0'&gt;&lt;tr&gt;&lt;td&gt;3V3&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 17&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 25&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D8 SCK&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 23 GPIO11 (shared)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D9 MISO&lt;/td&gt;&lt;td&gt;&amp;rarr;&lt;/td&gt;&lt;td&gt;pin 21 GPIO9 (shared)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D10 MOSI&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 19 GPIO10 (shared)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D7 CS&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;pin 26 CE1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D6 INT&lt;/td&gt;&lt;td&gt;&amp;rarr;&lt;/td&gt;&lt;td&gt;pin 18 GPIO24&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;Terminal: CANH, CANL → jumpers ↑" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#e0662b;arcSize=4;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="225" height="165" as="geometry"/></mxCell><mxCell id="c29" value="&lt;div style='text-align:center'&gt;JBH&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#f5f5f5;strokeColor=#e0662b;arcSize=4;rounded=0;spacingLeft=0;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="368" y="238" width="44" height="18" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=none;html=1;strokeColor=#e0662b;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="256" as="sourcePoint"/><mxPoint x="390" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="" style="endArrow=none;html=1;strokeColor=#e0662b;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="150" as="sourcePoint"/><mxPoint x="390" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;div style='text-align:center'&gt;JBL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#f5f5f5;strokeColor=#e0662b;arcSize=4;rounded=0;spacingLeft=0;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="438" y="238" width="44" height="18" as="geometry"/></mxCell><mxCell id="c33" value="" style="endArrow=none;html=1;strokeColor=#e0662b;strokeWidth=2;dashed=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="256" as="sourcePoint"/><mxPoint x="460" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="endArrow=none;html=1;strokeColor=#e0662b;strokeWidth=2;dashed=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="172" as="sourcePoint"/><mxPoint x="460" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;N1 cockpit · Raspberry Pi 4&lt;/b&gt;&lt;br&gt;SPI0 (kernel &lt;code&gt;mcp251x&lt;/code&gt;, 16 MHz osc)&lt;br&gt;CAN A = can on &lt;b&gt;spi0.0&lt;/b&gt; (CE0), CAN B = &lt;b&gt;spi0.1&lt;/b&gt; (CE1)&lt;br&gt;(can0/can1 names can swap: identify by CE)&lt;br&gt;Ethernet to laptop proxy (UDP 8000)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#eef3f8;strokeColor=#17365d;arcSize=4;" vertex="1" parent="1"><mxGeometry x="80" y="475" width="465" height="105" as="geometry"/></mxCell><mxCell id="c36" value="SPI + CS + INT + 3V3/GND" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="475" as="sourcePoint"/><mxPoint x="200" y="455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="475" as="sourcePoint"/><mxPoint x="440" y="455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;Test-point breadboard, N1&lt;/b&gt; (one signal per row)&lt;br&gt;&lt;table style='font-size:9px' cellpadding='1'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Row&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Signal&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Pin&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1-2&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;pin 6 / 9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;UDP_RX&lt;/td&gt;&lt;td&gt;pin 12 GPIO18&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;CMD_TX&lt;/td&gt;&lt;td&gt;pin 13 GPIO27&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;CAN_TX_A&lt;/td&gt;&lt;td&gt;pin 15 GPIO22&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;CAN_TX_B&lt;/td&gt;&lt;td&gt;pin 16 GPIO23&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;DEG_A (LED)&lt;/td&gt;&lt;td&gt;pin 31 GPIO6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;DEG_B (LED)&lt;/td&gt;&lt;td&gt;pin 29 GPIO5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9-13&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fffbea;strokeColor=#b58b00;arcSize=4;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="465" height="260" as="geometry"/></mxCell><mxCell id="c39" value="" style="endArrow=none;html=1;strokeColor=#b58b00;strokeWidth=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="312" y="580" as="sourcePoint"/><mxPoint x="312" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="560" as="sourcePoint"/><mxPoint x="66" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="66" y="560" as="sourcePoint"/><mxPoint x="66" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;CAN A module&lt;/b&gt; · P1 open (middle node)&lt;br&gt;&lt;table style='font-size:9px' cellpadding='0'&gt;&lt;tr&gt;&lt;td&gt;3V3&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;3V3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D8 SCK&lt;/td&gt;&lt;td&gt;&amp;larr;&lt;/td&gt;&lt;td&gt;PA5 (D13)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D9 MISO&lt;/td&gt;&lt;td&gt;&amp;rarr;&lt;/td&gt;&lt;td&gt;PA6 (D12)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D10 MOSI&