/* boards/nucleo_f401re.overlay */
/ {
	aliases {
		rpilink = &usart2;
		servo-pwm = &servo_pwm;
		blinker-fl = &blinker_fl;
        blinker-fr = &blinker_fr;
        blinker-rl = &blinker_rl;
        blinker-rr = &blinker_rr;
		motor-left-pwm = &motor_left_pwm;
		motor-right-pwm = &motor_right_pwm;
		motor-left-in1 = &motor_left_in1;
		motor-left-in2 = &motor_left_in2;
		motor-right-in3 = &motor_right_in3;
		motor-right-in4 = &motor_right_in4;
		encoder-right-a = &encoder_right_a;
		encoder-right-b = &encoder_right_b;
		encoder-left-a = &encoder_left_a;
		encoder-left-b = &encoder_left_b;
	};

	zephyr,user {
		/* Left motor A2/IN4, right motor A3/IN8, steering A1/IN1. */
		io-channels = <&adc1 4>, <&adc1 8>, <&adc1 1>;
	};

	blinkers {
        compatible = "gpio-leds";

		blinker_fl: blinker_fl {
			gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;    /* D14 */
        };
        blinker_fr: blinker_fr {
            gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;    /* D15 */
        };
        blinker_rl: blinker_rl {
            gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;    /* D9 */
        };
        blinker_rr: blinker_rr {
            gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;    /* D10 */
        };
    };

	/*
	 * L298N control wiring. These are logic-level connections only:
	 * channel A / physical left wheel: ENA -> A0/PA0 (TIM2_CH1),
	 * IN1 -> A4/PC1, IN2 -> A5/PC0;
	 * channel B / physical right wheel: ENB -> D2/PA10 (TIM1_CH3),
	 * IN3 -> D4/PB5, IN4 -> D3/PB3.
	 * The motor supply remains disconnected while this scaffold is tested.
	 */
	motor_pwm_outputs {
		compatible = "pwm-leds";

		motor_left_pwm: motor_left_pwm {
			pwms = <&pwm2 1 PWM_USEC(100) PWM_POLARITY_NORMAL>;
		};

		motor_right_pwm: motor_right_pwm {
			pwms = <&pwm1 3 PWM_USEC(100) PWM_POLARITY_NORMAL>;
		};
	};

	servo_outputs {
		compatible = "pwm-leds";

		servo_pwm: servo_pwm {
			pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	motor_direction_outputs {
		compatible = "gpio-leds";

		motor_left_in1: motor_left_in1 {
			gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>; /* A4 */
		};

		motor_left_in2: motor_left_in2 {
			gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>; /* A5 */
		};

		motor_right_in3: motor_right_in3 {
			gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>; /* D4 */
		};

		motor_right_in4: motor_right_in4 {
			gpios = <&gpiob 3 GPIO_ACTIVE_HIGH>; /* D3 */
		};
	};

	/*
	 * Part 3.1 encoder wiring. The physical left wheel is the L298N
	 * OUT1/OUT2 channel; the physical right wheel is OUT3/OUT4.
	 * Both encoder boards are powered from Nucleo 3V3 and common GND.
	 */
	encoder_inputs {
		compatible = "gpio-keys";

		encoder_right_a: encoder_right_a {
			gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>; /* D7, phase A */
		};

		encoder_right_b: encoder_right_b {
			gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>; /* D8, phase B */
		};

		encoder_left_a: encoder_left_a {
			gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>; /* D5, phase A */
		};

		encoder_left_b: encoder_left_b {
			gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>; /* D6, phase B */
		};
	};
};

/* D3/PB3, D4/PB5, and D5/PB4 are application GPIOs. */
&spi1 {
	status = "disabled";
};

/* D14/PB9, D15/PB8, and D7/PA8 are application GPIOs. */
&i2c1 {
	status = "disabled";
};

&i2c3 {
	status = "disabled";
};

&adc1 {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <1>; /* IN1, PA1 / A1 steering current */
        zephyr,resolution = <12>;
    };
    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <4>; /* IN4, PA4 / A2 left motor current */
        zephyr,resolution = <12>;
    };
    channel@8 {
        reg = <8>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <8>; /* IN8, PB0 / A3 right motor current */
        zephyr,resolution = <12>;
    };
};

&usart1 {
	/* D8/PA9 is right encoder B and D2/PA10 is ENB PWM. */
	status = "disabled";
};

&usart2 {
	/* Pi UART target: D1/PA2 TX and D0/PA3 RX. */
	status = "okay";
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
};

/* ENB uses D2/PA10, TIM1 channel 3. */
&timers1 {
	status = "okay";

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch3_pa10>;
		pinctrl-names = "default";
	};
};

/* Steering servo uses D12/PA6, TIM3 channel 1. */
&timers3 {
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pa6>;
		pinctrl-names = "default";
	};
};

/* ENA uses A0/PA0, TIM2 channel 1. */
&pwm2 {
	status = "okay";
	pinctrl-0 = <&tim2_ch1_pa0>;
	pinctrl-names = "default";
};

&adc1 {
	pinctrl-0 = <&adc1_in1_pa1 &adc1_in4_pa4 &adc1_in8_pb0>;
	pinctrl-names = "default";
};
